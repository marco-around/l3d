{
	"name": "api",
	"version": "0.0.1",
	"author": "marco-around",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --logHeapUsage --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.1",
		"@fastify/session": "^11.1.1",
		"@l3d/database": "workspace:*",
		"@nestjs/common": "^11.0.1",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-fastify": "^11.1.28",
		"@nestjs/swagger": "^11.4.5",
		"@scalar/nestjs-api-reference": "^1.2.9",
		"argon2": "^0.44.0",
		"connect-redis": "^8.0.0",
		"dotenv": "^16.6.1",
		"fastify": "^5.10.0",
		"ioredis": "^5.11.1",
		"nestjs-zod": "^5.4.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"slugify": "^1.6.9",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@l3d/typescript-config": "workspace:*",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.43",
		"@types/node": "catalog:",
		"@types/supertest": "^7.0.0",
		"@vitest/coverage-v8": "^4.1.9",
		"supertest": "^7.0.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "catalog:api",
		"vitest": "^4.1.9"
	}
}
